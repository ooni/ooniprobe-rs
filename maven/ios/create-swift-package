#!/bin/bash
set -euo pipefail

# create-swift-package generates a Package.swift manifest with two targets:
# - "passport", a binary target for passport.xcframework.zip.
# - "Passport", the Swift API that apps import.
#
# Usage: create-swift-package <path/to/passport.xcframework.zip> <path/to/Package.swift>

__zip=$1
__output=$2
__ref=${GITHUB_REF:-}
if [[ $__ref =~ ^refs/tags/v ]]; then
	__tag=${__ref#refs/tags/}
else
	__tag=rolling
fi
__repo="${GITHUB_REPOSITORY:-ooni/ooniprobe-rs}"
__checksum=$(shasum -a 256 "${__zip}" | cut -d ' ' -f 1)

cat >"${__output}" <<MANIFEST
// swift-tools-version:5.9
// Generated by maven/ios/create-swift-package for ${__tag}; DO NOT EDIT.
import PackageDescription

let package = Package(
    name: "Passport",
    platforms: [.iOS(.v13)],
    products: [
        .library(name: "Passport", targets: ["Passport"]),
    ],
    targets: [
        .binaryTarget(
            name: "passport",
            url: "https://github.com/${__repo}/releases/download/${__tag}/passport.xcframework.zip",
            checksum: "${__checksum}"
        ),
        // UniFFI bindings: ooniprobe.swift from the same release.
        .target(
            name: "Passport",
            dependencies: ["passport"],
            path: "Sources/Passport"
        ),
    ]
)
MANIFEST
